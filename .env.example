# Copia este archivo a .env (en la raíz del repo) y completa los valores. .env NUNCA se sube a git.

ENTORNO=desarrollo

# Postgres local (Homebrew). En producción, la URL de la base que elija la UVG.
DATABASE_URL=postgresql://localhost:5432/chatbot_uvg

# OpenRouter: misma key para chat y embeddings. Ponle límite de crédito en openrouter.ai.
OPENROUTER_API_KEY=sk-or-v1-pega-tu-key-aqui
MODELO_CHAT=openai/gpt-oss-120b
# Elegido en la fase 1 (Acierto@4 25/26; qwen3-embedding no tenía proveedores). "local" = sin red (solo pruebas).
MODELO_EMBEDDINGS=openai/text-embedding-3-small

# Búsqueda
TOP_K=4
UMBRAL_SIMILITUD=0.35

# Chat (fase 2)
LARGO_MAX_MENSAJE=500
MAX_TOKENS_RESPUESTA=700

# Topes de uso. Para correr el examen contra el backend, sube LIMITE_IP_MINUTO (p. ej. 1000).
LIMITE_IP_MINUTO=10
LIMITE_IP_DIA=100
LIMITE_GLOBAL_DIA=3000

# Seguridad. En producción: SECRETO_SESION largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRETO_SESION=cambiar-en-produccion
DOMINIOS_PERMITIDOS=localhost,127.0.0.1
RETENCION_DIAS=90

# Panel de administración (/admin). Déjala vacía para desactivar el panel.
# Usa una contraseña larga y no la compartas por chat.
ADMIN_PASSWORD=
MAX_SUBIDA_MB=5
